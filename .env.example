# Configure these in the hosting provider; the server does not auto-load .env.
PORT=3000
SHOPIER_API_TOKEN=
RESEND_API_KEY=
# Optional override; defaults to the existing public Google web client ID.
# GOOGLE_CLIENT_ID=
# Strong, separate secrets; empty values deny access.
ADMIN_TOKEN=
WEBHOOK_TOKEN=
# Neon Connect > pooled PostgreSQL URI. Keep this value secret.
DATABASE_URL=
# Keep false until existing sales AND claims have been imported and checked.
LICENSE_MIGRATION_COMPLETE=false
NODE_ENV=production
# Development-only file fallback (not persistent on Render's free plan):
# LICENSE_DATA_DIR=./keys
