# Configure these in the hosting provider; the server does not auto-load .env.
PORT=3000
# OpenAI Responses API key; configure as a secret in Render, never in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
SHOPIER_API_TOKEN=
RESEND_API_KEY=
# Optional override; defaults to the existing public Google web client ID.
# GOOGLE_CLIENT_ID=
# Strong, separate secrets; empty values deny access.
ADMIN_TOKEN=
WEBHOOK_TOKEN=
# Neon Connect > pooled PostgreSQL URI. Keep this value secret.
DATABASE_URL=
# Keep false until existing sales AND claims have been imported and checked.
LICENSE_MIGRATION_COMPLETE=false
NODE_ENV=production
# Development-only file fallback (not persistent on Render's free plan):
# LICENSE_DATA_DIR=./keys
# Optional abuse limits (defaults in parentheses; leave empty to use them).
# Total AI assistant requests per UTC day across all users (300).
AI_DAILY_REQUEST_LIMIT=
# Claim/check-license requests per IP per hour (20) and for all callers per hour (2000).
LICENSE_RATE_LIMIT_PER_IP=
LICENSE_RATE_LIMIT_GLOBAL=
# Google sign-in requests per IP per hour (30) and for all callers per hour (3000).
AUTH_RATE_LIMIT_PER_IP=
AUTH_RATE_LIMIT_GLOBAL=
# Reverse proxies in front of the server that append to X-Forwarded-For (1). Render: 1 (its edge
# appends the client address as the last entry; confirm in Render logs). 0 ignores X-Forwarded-For
# and uses the TCP peer address (direct exposure, local runs). Too high a value lets clients spoof.
TRUST_PROXY_HOPS=
# Maximum client addresses kept by each in-memory rate limiter; the oldest are dropped first (100000).
RATE_LIMIT_MAX_KEYS=
