# Configure these in the hosting provider; the server does not auto-load .env.
PORT=3000
SHOPIER_API_TOKEN=
RESEND_API_KEY=
# Strong, separate secrets; empty values deny access.
ADMIN_TOKEN=
WEBHOOK_TOKEN=
# Point to a persistent disk, preserving both sold_licenses.json and claimed_licenses.json.
LICENSE_DATA_DIR=/var/data/bar-cepte
