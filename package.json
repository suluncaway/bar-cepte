{
  "name": "bar-cepte",
  "productName": "Bar Cepte",
  "version": "1.1.0",
  "description": "Bar Cepte — Akıllı Bar & Kokteyl Asistanı",
  "main": "main.js",
  "author": {
    "name": "suluncaway",
    "email": "suluncaway@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/suluncaway/bar-cepte",
  "repository": {
    "type": "git",
    "url": "https://github.com/suluncaway/bar-cepte.git"
  },
  "scripts": {
    "start": "electron .",
    "webhook": "node scripts/shopier-webhook.js",
    "start:webhook": "node scripts/shopier-webhook.js",
    "dist": "electron-builder --publish never",
    "sign": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-exe.ps1",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "test": "node --test tests/*.test.cjs",
    "import:licenses": "node scripts/import-licenses.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3"
  },
  "build": {
    "appId": "com.barcepte.app",
    "productName": "Bar Cepte",
    "files": [
      "index.html",
      "landing.html",
      "landing.css",
      "privacy.html",
      "privacy.js",
      "style.css",
      "visual-refresh.css",
      "tailwind.css",
      "game.js",
      "security.js",
      "ui-bindings.js",
      "dynamic-ui.js",
      "support.js",
      "editorial-ui.js",
      "editorial-cocktails.webp",
      "hero-cocktail-ambient.mp4",
      "shopier-aylik-kart.png",
      "manifest.json",
      "sw.js",
      "cocktails.json",
      "ads.js",
      "ads.txt",
      "reserve.js",
      "auth.js",
      "firebase-config.js",
      "icon.png",
      "main.js",
      "web-assets.json",
      "build/icon.png",
      "storage-migration.js",
      "personal-bar.js",
      "personal-ui.js",
  "inventory.js",
  "business.html", "business.css", "business-rules.js", "business-ui.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "BarCepte-Setup.${ext}"
    },
    "portable": {
      "artifactName": "BarCepte-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "BarCepte-Linux.${ext}"
    },
    "deb": {
      "artifactName": "BarCepte-Linux.${ext}"
    }
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
