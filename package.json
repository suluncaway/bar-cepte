{
  "name": "bar-cepte",
  "productName": "Bar Cepte",
  "version": "1.1.0",
  "description": "Bar Cepte — Akıllı Bar & Kokteyl Asistanı",
  "main": "main.js",
  "author": {
    "name": "suluncaway",
    "email": "suluncaway@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/suluncaway/bar-cepte",
  "repository": {
    "type": "git",
    "url": "https://github.com/suluncaway/bar-cepte.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "sign": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-exe.ps1",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.0"
  },
  "build": {
    "appId": "com.barcepte.app",
    "productName": "Bar Cepte",
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "tailwind.css",
      "security.js",
      "ui-bindings.js",
      "dynamic-ui.js",
      "support.js",
      "manifest.json",
      "sw.js",
      "main.js",
      "cocktails.json",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "BarCepte-Setup.${ext}"
    },
    "portable": {
      "artifactName": "BarCepte-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "BarCepte-Linux.${ext}"
    },
    "deb": {
      "artifactName": "BarCepte-Linux.${ext}"
    }
  }
}
