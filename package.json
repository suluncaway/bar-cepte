{
  "name": "bar-cepte",
  "productName": "Bar Cepte",
  "version": "1.1.0",
  "description": "Bar Cepte — Akıllı Bar & Kokteyl Asistanı",
  "main": "main.js",
  "author": {
    "name": "suluncaway",
    "email": "suluncaway@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/suluncaway/bar-cepte",
  "repository": {
    "type": "git",
    "url": "https://github.com/suluncaway/bar-cepte.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "sign": "powershell -ExecutionPolicy Bypass -File ./scripts/sign-exe.ps1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.barcepte.app",
    "productName": "Bar Cepte",
    "files": [
      "index.html",
      "style.css",
      "game.js",
      "manifest.json",
      "sw.js",
      "main.js",
      "build/icon.png"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico",
      "certificateFile": "certs/BarCepte.pfx",
      "certificatePassword": "BarCepte2026!"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "BarCepte-Setup.${ext}"
    },
    "portable": {
      "artifactName": "BarCepte-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "BarCepte-Linux.${ext}"
    },
    "deb": {
      "artifactName": "BarCepte-Linux.${ext}"
    }
  }
}
